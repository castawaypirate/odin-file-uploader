<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="/js/dashboardView.js" defer></script>
    <title>Dashboard</title>
  </head>
  <body>
    <%- include("partial/header.ejs") %>
    <div class="content">
      <h1>Dashboard</h1>
      <%=currentUser.username%>
      <a href="/upload">Upload file</a>
      <a href="/folders/new">New folder</a>
      <h3>Folders</h3>
      <ul>
      <% for (let folder of root.subfolders) {%>
        <li>
          <a href="/folders/<%=folder.id%>"><%=folder.name%></a>
          <a href="/folders/edit/<%=folder.id%>">Edit</a>
          <button class="delete-folder-btn" type="button" data-id="<%=folder.id%>">Delete</button>
        </li>
      <%}%>
      </ul>
    </div>
  </body>
</html>
