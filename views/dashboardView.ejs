<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Dashboard</title>
  </head>
  <body>
    <%- include("partial/header.ejs") %>
    <div class="content">
      <%=currentUser.username%>
      <a href="/upload">Upload file</a>
      <a href="/folders/new">New folder</a>
      <h3>Folders</h3>
      <ul>
      <% for (let folder of root.subfolders) {%>
        <li>
          <a href="/folders/<%=folder.id%>"><%=folder.name%></a>
          <a href="">Edit</a>
          <a href="">Delete</a>
        </li>
      <%}%>
      </ul>
    </div>
  </body>
</html>
