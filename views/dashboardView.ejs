<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="/js/dashboardView.js" defer></script>
    <title>Dashboard</title>
  </head>
  <body>
    <%- include("partial/header.ejs") %>
    <div class="content">
      <h1>Dashboard</h1>
      <div>Hello, <%=currentUser.username%></div>
      <a href="/folders/new">New folder</a>
      <%- include("partial/folders.ejs", {subfolders: root.subfolders}) %>
      <%- include("partial/files.ejs", {files: root.files, context: "root"}) %>
      <%- include("partial/uploadForm.ejs", {context: "root"}) %>
    </div>
  </body>
</html>
