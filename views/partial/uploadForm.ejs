<h3>Upload file</h3>  
<form action="/upload?context=<%=context%>" method="POST" enctype="multipart/form-data">
  <%-include("errors.ejs")%>
  <div class="form-control">
    <label for="file">Choose file</label>
    <input type="file" name="file" id="file" value="">
  </div>
  <button type="submit">Upload</button>
</form>
