<h3>Files</h3>
<dialog id="delete-file-dialog" class="modal-dialog">
  <form method="POST" class="dialog-form">
    <p class="dialog-title">Delete File</p>
    <p class="dialog-desc">Are you sure you want to permanently delete this file?</p>
    <div class="dialog-actions">
      <button commandfor="delete-file-dialog" type="submit" class="btn-delete">Delete</button>
      <button commandfor="delete-file-dialog" command="close" type="button" class="btn-cancel">Cancel</button>
    </div>
  </form>
</dialog>

<dialog id="edit-file-dialog" class="modal-dialog">
  <form method="POST" class="dialog-form">
    <p class="dialog-title">Edit File</p>
    <div class="form-control">
      <label for="filename">Name</label>
      <input type="text" id="filename" name="filename" required>
    </div>
    <div class="dialog-actions">
      <button commandfor="edit-file-dialog" type="submit" class="btn-primary">Update</button>
      <button commandfor="edit-file-dialog" command="close" type="button" class="btn-cancel">Cancel</button>
    </div>
  </form>
</dialog>

<ul class="item-list">
  <% if (files && files.length > 0) {%>
    <% for (let file of files) {%>
      <li>
        <a href="/files/<%=file.id%>"><%=file.filename%></a>
        <button class="download-file-btn" type="button"><a href="/download/<%=file.id%>">Download</a></button>
        <button class="edit-file-btn" type="button" data-context="<%=context%>" data-file-id="<%=file.id%>" data-filename="<%=file.filename%>">Edit</button>
        <button class="delete-file-btn" type="button" data-context="<%=context%>" data-file-id="<%=file.id%>" >Delete</button>
      </li>
    <%}%>
  <%} else {%>
    <p>No uploaded files yet in this folder</p>
  <%}%>
</ul>
