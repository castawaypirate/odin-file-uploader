<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="/js/clipboard.js" defer></script>
    <title>Share</title>
  </head>
  <body>
    <%- include("partial/header.ejs") %>
    <div class="content">
      <%if (locals.folder.shareLinks.length > 0) {%>
       <h1>Existing links</h1>
       <%for (let link of folder.shareLinks) {%>
        <div>
        <input type="text" id="<%=link.id%>" value="<%=url%>/share/<%=link.token%>" onclick="this.select() "readonly>
          <div>
            <% if (link.expiresAt) {%>
              <%=link.expiresAt%>
            <%} else {%>
              No expiration date
            <%} %>
          </div>
          <div>
            <button type="button"><a href="<%=url%>/share/<%=link.token%>">View</a></button> 
            <button type="button" onclick="copyLink('<%=link.id%>')" >Copy</button> 
          </div>
        </div>
        <%}%>
      <%}%>
      <h1>Share folder</h1>
      <form action="/folders/<%=locals.folder.id%>/share" method="POST">
        <div class="form-control">
          <label for="expiration">Link expiration</label>
          <select id="expiration" name="expiration">
            <option value="1d">1 day</option>
            <option value="7d">7 days</option>
            <option value="30d">30 days</option>
            <option value="never">Never</option>
          </select>
        </div>
        <button type="submit">Generate link</button>
      </form>
    </div>
  </body>
</html>
