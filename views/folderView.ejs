<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script src="/js/folderView.js" defer></script>
    <title><%=locals.folder?.name%></title>
  </head>
  <body>
    <%- include("partial/header.ejs") %>
    <div class="content">
      <h2><%=locals.folder?.name%></h2>
      <a href="/folders/new?parentFolderId=<%=locals.folder?.id%>">New subfolder</a>
      <a href="/folders/edit/<%=locals.folder?.id%>">Edit</a>
      <button type="button" data-id="<%=locals?.folder.id%>" id="delete-current-folder-btn">Delete</button>
      <h3>Folders</h3>
      <ul>
        <% for (let folder of locals.folder?.subfolders) {%>
        <li>
          <a href="/folders/<%=folder.id%>"><%=folder.name%></a>
          <a href="/folders/edit/<%=folder.id%>">Edit</a>
          <button class="delete-subfolder-btn" type="button" data-id="<%=folder.id%>">Delete</button>
        </li>
        <%}%>
      </ul>
      <!-- <h3>Files</h3> -->
      <!-- <ul> -->
      <!-- </ul> -->
    </div>
  </body>
</html>
