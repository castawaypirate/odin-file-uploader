<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/global.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/fileDetailsView.css">
    <title><%= locals.file?.filename || 'File details' %></title>
  </head>
  <body>
    <%- include("partial/header.ejs") %>
    <main class="content">
      <div class="path">
        <a href="/share/<%= locals.token %>/folders/<%= locals.folderId %>">&larr; Back to folder</a>
      </div>

      <div class="file-card">
        <div class="file-card-header">
          <h1 class="file-title"><%= locals.file?.filename %></h1>
        </div>

        <div class="file-meta">
          <div class="meta-item">
            <span class="meta-label">Uploaded</span>
            <span class="meta-value"><%= locals.file?.uploadedAt ? new Date(file.uploadedAt).toLocaleDateString() : '' %></span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Size</span>
            <span class="meta-value font-mono"><%= locals.file?.size %></span>
          </div>
        </div>

      </div>
    </main>
  </body>
</html>
