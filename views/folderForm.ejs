<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%=locals.edit? 'Edit folder' : 'New folder'%></title>
  </head>
  <body>
    <%- include("partial/header.ejs") %>
    <div class="content">
      <h1><%=locals.edit? 'Edit folder' : 'New folder'%></h1>
      <% if (locals.edit) {%>
      <form action="<%=action%>" method="POST">
      <%} else {%>
      <form action="/folders/new<%=locals.parentFolderId ? `?parentFolderId=${locals.parentFolderId}`: '' %>" method="POST">
      <%}%>
      <%- include("partial/errors.ejs") %>
        <div class="form-control">
          <label for="name">Name</label>
          <input type="text" name="name" id="name" value="<%=locals.folderName ? folderName : '' %>">
        </div>
        <button type="submit"><%=locals.edit? 'Update' : 'Create'%></button>
      </form>
    </div>
  </body>
</html>
